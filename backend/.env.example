NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/findback
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters

# Optional: when omitted, development photos are stored in backend/uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: an image-embedding service endpoint accepting { "imageUrl": "..." }
# and returning { "embedding": [0.1, 0.2, ...] }. Failed requests fall back to attributes.
IMAGE_EMBEDDING_URL=
IMAGE_EMBEDDING_TOKEN=
PUBLIC_API_URL=

# Matching weights are percentages; visual weight is a 0–1 share.
MATCH_WEIGHT_CATEGORY=30
MATCH_WEIGHT_COLOR=20
MATCH_WEIGHT_BRAND=20
MATCH_WEIGHT_KEYWORD=5
MATCH_WEIGHT_KEYWORD_MAX=20
MATCH_WEIGHT_LOCATION=10
MATCH_WEIGHT_DATE=10
MATCH_MIN_SCORE=25
MATCH_VISUAL_WEIGHT=0.3

# Set only when promoting an already registered user to admin.
ADMIN_EMAIL=
